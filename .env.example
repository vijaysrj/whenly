# Postgres connection string. Adding the Neon integration in Vercel sets this for you.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Your Anthropic API key, from https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...

# The password you type to sign in to Whenly.
APP_PASSWORD=choose-a-long-password

# Random string of 32+ characters used to sign the sign-in cookie.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=
